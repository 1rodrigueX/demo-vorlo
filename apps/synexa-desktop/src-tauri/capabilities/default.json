{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões base do app Synexa (launcher + janela do CRM).",
  "windows": ["main", "crm"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:webview:allow-create-webview-window",
    "updater:default",
    "process:allow-restart",
    "opener:default"
  ]
}
