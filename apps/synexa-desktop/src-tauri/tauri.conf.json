{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Synexa",
  "version": "0.1.0",
  "identifier": "cloud.synexa.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://falaai.cloud/api/app/update/{{target}}/{{current_version}}"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFQjhFOTdEQ0M5MEVGMzMKUldRejc1RE1mZW00ZnI4bFdxNS9EMERQOEJLbkd6S2ZrZU9qdmlHRURLU2pULzRtYS93elJxOWsK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Synexa",
    "category": "Business",
    "shortDescription": "Synexa — CRM, vendas e automações",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
