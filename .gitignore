# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# supabase CLI local cache
/supabase/.temp/

# WhatsApp (Baileys) session — equivalent to an active, no-2FA login session
/.baileys_auth

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code internal
.claude/

# build web gerado do app Flutter (apps/frete-app) — nunca commitado, vai
# direto pra VPS via GitHub Actions (mesmo esquema do APK), igual node_modules
/public/app-web/

# chaves SSH do deploy (GitHub Actions → VPS) — NUNCA commitar chave privada
/github-actions
/github-actions.pub

# Gravações de demo (vídeo bruto — não versionar)
scripts/video/out/
