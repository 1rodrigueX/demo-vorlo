# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Base URL usada pra montar as URLs de callback (webhook do Twilio, OAuth do
# Bling). Em produção, use o domínio real; em dev local, um túnel (ngrok) se
# precisar testar webhooks reais.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp (Twilio/Baileys) e Bling agora são configurados por CRM, direto na
# tela de Configurações (cada dono cola o Client ID/Secret do próprio app
# Bling) — não há mais credenciais globais aqui pra eles.

# Anthropic — console.anthropic.com/settings/keys (chave da API do Claude, usada pelo assistente de IA)
ANTHROPIC_API_KEY=
# Opcional — troca o modelo usado pelo assistente (padrão: claude-opus-4-8)
ANTHROPIC_MODEL=
