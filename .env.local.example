# ── Banco (PostgreSQL + Prisma) ──────────────────────────────────────────
# Conexão direta com o Postgres. Durante a migração do Supabase, aponte para o
# MESMO banco que a aplicação já usa: Supabase → Project Settings → Database →
# Connection string → URI (a que termina em :5432, não a do pooler, senão o
# `prisma db pull` e as migrations não funcionam).
#
# É o que falta pra rodar:
#   npx prisma db pull   → escreve os ~60 modelos em prisma/schema.prisma
#   npx prisma generate  → gera o client tipado
DATABASE_URL=

# ── Supabase ─────────────────────────────────────────────────────────────
# Ainda em uso: auth, storage e realtime seguem no Supabase enquanto a
# migração acontece por partes. Só saem daqui quando as três forem portadas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Base URL usada pra montar as URLs de callback (webhook do Twilio, OAuth do
# Bling). Em produção, use o domínio real; em dev local, um túnel (ngrok) se
# precisar testar webhooks reais.
NEXT_PUBLIC_SITE_URL=http://45.149.153.20

# WhatsApp (Twilio/Baileys) e Bling agora são configurados por CRM, direto na
# tela de Configurações (cada dono cola o Client ID/Secret do próprio app
# Bling) — não há mais credenciais globais aqui pra eles.

# Opcional — troca o modelo padrão dos agentes de IA (padrão: claude-opus-4-8).
# A chave da Anthropic pros agentes de negócio (SDR etc.) é por tenant
# (Configurações > Inteligência Artificial), não fica aqui.
ANTHROPIC_MODEL=

# Chave da plataforma — usada só como fallback pro agente FALA AI (aba
# Suporte) quando o tenant não conectou a própria chave. Nunca é exposta ao
# navegador nem a nenhum tenant; fica só no servidor.
PLATFORM_ANTHROPIC_API_KEY=

# Mercado Pago — mercadopago.com.br/developers/panel > Suas integrações > credenciais
# (checkout da landing page + cobrança mensal recorrente)
MERCADOPAGO_ACCESS_TOKEN=
# Mesma tela, aba "Webhooks" — necessário pra validar a assinatura das notificações
MERCADOPAGO_WEBHOOK_SECRET=

# Segredo compartilhado com o crontab da VPS que chama /api/cron/billing-cycle
# 1x/dia (gera a cobrança mensal de quem está due). Qualquer string aleatória.
CRON_SECRET=

# Resend — resend.com/api-keys (envio do e-mail de boas-vindas pós-compra)
RESEND_API_KEY=
# Remetente verificado no Resend; sem domínio próprio, use o sandbox onboarding@resend.dev
RESEND_FROM_EMAIL=onboarding@resend.dev

# Google Cloud Console > APIs & Services > Credentials — app OAuth único da
# plataforma pra "Conectar com Gmail" (todo cliente usa o mesmo app, cada um
# loga com a própria conta). Redirect URI a cadastrar no Google:
#   {NEXT_PUBLIC_SITE_URL}/api/integrations/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure Portal > App registrations — mesma ideia, pro "Conectar com Outlook".
# Redirect URI a cadastrar no Azure:
#   {NEXT_PUBLIC_SITE_URL}/api/integrations/outlook/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# developer.spotify.com/dashboard — app OAuth único da plataforma pra
# "Conectar Spotify" na aba Música (cada usuário conecta a própria conta
# pessoal, precisa ser Premium pra tocar faixa completa). Redirect URI a
# cadastrar no Spotify — exige HTTPS em produção, não aceita IP puro:
#   {NEXT_PUBLIC_SITE_URL}/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Caminho do binário do ffmpeg (usado pra converter áudio gravado no
# navegador pra ogg/opus antes de enviar como nota de voz no WhatsApp).
# Deixe em branco se "ffmpeg" já estiver no PATH do sistema.
FFMPEG_PATH=
